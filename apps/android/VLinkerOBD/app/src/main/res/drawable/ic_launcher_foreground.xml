<?xml version="1.0" encoding="utf-8"?>
<!--
  Speedometer dial (matches ui/gauge/Gauge.kt's own arc/tick/needle look) with a two-tone
  compass-style needle: today it reads as "live OBD gauge", but the same dart-and-tail needle
  shape is also the universal "direction/heading" glyph, so it keeps making sense once
  navigation, speed-camera alerts, and other driving-info features (per ROADMAP.md) are added
  alongside the dashboard rather than needing a re-brand. A small exhaust-valve accent sits in
  the dial's own open bottom wedge, nodding to the engine-block imagery other OBD app icons use
  (iOBD2, Car Scanner ELM OBD2) without displacing the gauge as the primary shape.

  All geometry is kept within ~30dp of the 108x108 center: the first cut of this icon used the
  in-app gauge's own radius (36) and got visibly clipped by this launcher's adaptive-icon mask —
  real launchers crop more aggressively than the nominal safe-zone spec suggests.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- dial track -->
    <path
        android:pathData="M28.02,69 A30,30 0 1 1 79.98,69"
        android:strokeColor="#2A303C"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- filled portion up to the needle, echoing the live-reading arc in the in-app gauge -->
    <path
        android:pathData="M28.02,69 A30,30 0 0 1 69,28.02"
        android:strokeColor="#22D3EE"
        android:strokeAlpha="0.9"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- tick marks -->
    <path
        android:pathData="M35.81,64.5 L31.48,67 M34.03,47.51 L29.27,45.97 M45.45,34.81 L43.42,30.24 M62.55,34.81 L64.58,30.24 M73.97,47.51 L78.73,45.97 M72.19,64.5 L76.52,67"
        android:strokeColor="#8B93A3"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- needle tail (dim half) -->
    <path
        android:fillColor="#0E7490"
        android:pathData="M54,54 L56.17,55.25 L50,60.93 L51.83,52.75 Z" />

    <!-- needle tip (bright half) -->
    <path
        android:fillColor="#22D3EE"
        android:pathData="M66,33.22 L56.17,55.25 L54,54 L51.83,52.75 Z" />

    <!-- pivot -->
    <path
        android:fillColor="#E7ECF3"
        android:pathData="M54,54 m-3,0 a3,3 0 1,0 6,0 a3,3 0 1,0 -6,0" />

    <!-- exhaust-valve accent, sitting in the dial's own open bottom wedge -->
    <path
        android:fillColor="#3A4150"
        android:pathData="M49,74 L59,74 L61.5,82 L46.5,82 Z" />
    <path
        android:pathData="M49,74 L59,74"
        android:strokeColor="#8B93A3"
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />
</vector>
